# Include any files or directories that you don't want to be copied to your
# container here (e.g., local build artifacts, temporary files, etc.).
#
# For more help, visit the .dockerignore file reference guide at
# https://docs.docker.com/go/build-context-dockerignore/

**/.DS_Store
**/__pycache__
**/.venv
**/.classpath
**/.dockerignore
**/.env
**/.git
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/bin
**/charts
**/docker-compose*
**/compose.y*ml
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
**/build
LICENSE
README.md

# The runtime image packages the one canonical CI Release build. Re-include
# only that build subtree after the broad local-artifact exclusions above.
!build/
!build/qt-prod/
!build/qt-prod/bin/
!build/qt-prod/bin/Release/
!build/qt-prod/bin/Release/**
!build/qt-prod/qt-evaluator-bundle/
!build/qt-prod/qt-evaluator-bundle/**
!build/qt-prod/release-files.sha256
